{
  "name": "akodo",
  "version": "0.1.0",
  "description": "Open source AI agent orchestrator — from prompt to production",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "Akodo Contributors",
  "license": "MIT",
  "homepage": "https://github.com/akodo-dev/akodo",
  "repository": {
    "type": "git",
    "url": "https://github.com/akodo-dev/akodo"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite\" \"tsc -p tsconfig.main.json --watch\" \"node scripts/wait-for-vite.js && cross-env NODE_ENV=development electron .\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.main.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && node -e \"require('fs').writeFileSync('dist/main/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
